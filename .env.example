# Copy this file to .env (never commit .env) before running `docker compose build`.

# Same uid/gid as your host user, so files written to ./data and ./manifests belong to you.
# Run `id -u` and `id -g` and copy the values here.
HOST_UID=1000
HOST_GID=1000

# Optional: the code_contests dataset is public, so a token is not required.
# It only raises the Hugging Face rate limits.
HF_TOKEN=
