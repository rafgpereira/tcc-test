# Copy this file to .env (never commit .env) before running `docker compose build`.

# HOST_UID / HOST_GID: NOT arbitrary values. They are the numeric ids of YOUR user and group on
# this machine, so the files the containers write to ./data and ./manifests belong to you.
# Get them with `id -u` (HOST_UID) and `id -g` (HOST_GID); on a single-user Linux PC both are
# usually 1000. Or let a command fill them (see the root README, "Guia de execução", Passo 2):
#   [ -f .env ] || printf 'HOST_UID=%s\nHOST_GID=%s\nHF_TOKEN=\n' "$(id -u)" "$(id -g)" > .env
# Also run `mkdir -p data` once: if ./data does not exist, Docker creates it as root and the
# `app` service cannot write to it.
HOST_UID=1000
HOST_GID=1000

# Optional: the code_contests dataset is public, so a token is not required.
# It only raises the Hugging Face rate limits.
HF_TOKEN=

# Local model (Qwen2.5-Coder-14B via Ollama), used only by `python -m ai_clients generate`.
# OLLAMA_BASE_URL: address of the Ollama server. For Ollama running on THIS machine use
#   http://host.docker.internal:11434 (the `app` service maps that name to the host);
#   for a remote server use http://<server>:11434.
# OLLAMA_HARDWARE_LABEL: free text describing the machine where Ollama runs (GPU, CPU, RAM), for
#   example "RTX 3060 12GB, Ryzen 5 5600". Written as-is next to every answer of the model; it is
#   never detected automatically (Ollama may run on another machine).
OLLAMA_BASE_URL=
OLLAMA_HARDWARE_LABEL=

# Optional. OLLAMA_HTTP_TIMEOUT_S: the longest wait without receiving anything from Ollama (default
# 900; the answer is streamed, so a long answer that keeps arriving is never cut; raise it if Ollama
# runs on CPU). OLLAMA_MAX_INFRA_RETRIES: how many consecutive times the same call is retried when
# Ollama is unreachable before the command stops (default 30). Neither changes any answer.
# OLLAMA_HTTP_TIMEOUT_S=900
# OLLAMA_MAX_INFRA_RETRIES=30

# Optional. OLLAMA_MODEL: another Ollama model, only for a pilot that compares models (default
# qwen2.5-coder:14b, the model of the experiment). It must be installed (`ollama pull <model>`). A
# run records its model and `--resume` refuses another one, so start a new run when changing it.
# The seed and the temperature of each attempt are fixed by the attempt policy, not set here.
# OLLAMA_MODEL=qwen2.5-coder:7b
