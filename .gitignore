# Experiment data is never versioned as loose files (Constitution, Principle II).
# The only exceptions are the packaged dataset and the packaged mutants of the final run
# (amendment 1.6.0); the mutants of day-to-day development stay under data/mutants/, ignored.
data/*
!data/dataset.zip
!data/mutants.zip

# Secrets: only .env.example is versioned.
.env

# Python and tool caches
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.venv/

# Claude Code worktrees (not used by default in this project, Constitution Princípio X;
# ignored so a one-off worktree never shows up as noise in `git status`)
.claude/worktrees/
